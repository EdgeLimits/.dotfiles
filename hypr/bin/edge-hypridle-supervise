#!/bin/bash

# Hand hypridle to systemd so it restarts if it dies.
#
# Omarchy's default autostart runs `uwsm-app -- hypridle` in a transient scope
# with no restart policy. hypridle is the only thing that runs the wake command
# on resume, so if it dies while the displays are blanked the screen stays dark
# until you blind-type your password into hyprlock. The packaged
# hypridle.service plus the Restart=always drop-in in
# ~/.config/systemd/user/hypridle.service.d/ fixes that.
#
# Omarchy's autostart.conf is read-only (it lives under ~/.local/share/omarchy),
# so its exec-once cannot be removed -- we replace the instance it started.

systemctl --user stop hypridle.service >/dev/null 2>&1
pkill -x hypridle >/dev/null 2>&1
sleep 1
systemctl --user start hypridle.service
