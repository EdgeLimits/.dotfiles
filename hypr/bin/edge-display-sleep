#!/bin/bash

# Blank internal panels only. Never touches external outputs.
#
# `hyprctl dispatch dpms off` does not just blank an external DisplayPort
# output, it disables it ("drm: Disabling output DP-1" / "enabledState changed
# true -> false" / "releasing crtc"). That drops the DP link, and the connector
# can come back reporting disconnected, at which point Hyprland has no monitor
# left to re-enable and a later `dpms on` is a no-op. With the lid shut and
# eDP-1 already disabled that leaves zero enabled outputs -- machine alive,
# monitor black, no way back in.
#
# Internal panels never disconnect, so blanking those is safe.

omarchy-brightness-keyboard off >/dev/null 2>&1

for m in $(hyprctl monitors -j | jq -r '.[].name'); do
  case "$m" in
  eDP-*) hyprctl dispatch dpms off "$m" >/dev/null 2>&1 ;;
  esac
done
