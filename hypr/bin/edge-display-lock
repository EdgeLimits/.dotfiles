#!/bin/bash

# Idle lock action.
#
# OMARCHY_LOCK_ONLY=true makes omarchy-system-lock skip its own display-off
# block, which would `dpms off` every output including external ones. We then
# blank internal panels only, via edge-display-sleep.

OMARCHY_LOCK_ONLY=true omarchy-system-lock

(
  sleep 3
  pidof hyprlock >/dev/null || exit 0
  edge-display-sleep
) &
