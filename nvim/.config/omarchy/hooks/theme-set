#!/bin/bash

# Called by `omarchy theme set` with the kebab-cased theme slug (e.g. "tokyo-night").
#
# Omarchy's own per-theme neovim.lua files aren't consistent enough to parse
# generically (some point at plugins we don't have installed, some use
# colorscheme strings that only make sense to LazyVim's own resolver). So
# instead we map straight to the colorscheme plugins already loaded in
# lua/plugins/omarchy-theme-list.lua and rewrite theme.lua ourselves.

set -euo pipefail

THEME_SLUG="$1"
THEME_FILE="$HOME/.config/nvim/lua/plugins/theme.lua"

declare -A THEME_PLUGIN=(
  [aether]="bjarneo/aether.nvim"
  [ethereal]="bjarneo/ethereal.nvim"
  [hackerman]="bjarneo/hackerman.nvim"
  [catppuccin]="catppuccin/nvim"
  [catppuccin-latte]="catppuccin/nvim"
  [everforest]="sainnhe/everforest"
  [flexoki-light]="kepano/flexoki-neovim"
  [gruvbox]="ellisonleao/gruvbox.nvim"
  [kanagawa]="rebelot/kanagawa.nvim"
  [matte-black]="tahayvr/matteblack.nvim"
  [nord]="shaunsingh/nord.nvim"
  [ristretto]="loctvl842/monokai-pro.nvim"
  [rose-pine]="rose-pine/neovim"
  [tokyo-night]="folke/tokyonight.nvim"
)

# Only needed when the repo's last path segment isn't the lazy plugin name
# already registered by omarchy-theme-list.lua.
declare -A THEME_PLUGIN_NAME=(
  [catppuccin]="catppuccin"
  [catppuccin-latte]="catppuccin"
  [rose-pine]="rose-pine"
  [ristretto]="monokai-pro"
)

declare -A THEME_COLORSCHEME=(
  [aether]="aether"
  [ethereal]="ethereal"
  [hackerman]="hackerman"
  [catppuccin]="catppuccin-mocha"
  [catppuccin-latte]="catppuccin-latte"
  [everforest]="everforest"
  [flexoki-light]="flexoki-light"
  [gruvbox]="gruvbox"
  [kanagawa]="kanagawa"
  [matte-black]="matteblack"
  [nord]="nord"
  [ristretto]="monokai-pro-ristretto"
  [rose-pine]="rose-pine"
  [tokyo-night]="tokyonight-night"
)

PLUGIN="${THEME_PLUGIN[$THEME_SLUG]:-}"
COLORSCHEME="${THEME_COLORSCHEME[$THEME_SLUG]:-}"

if [[ -z $PLUGIN || -z $COLORSCHEME ]]; then
  notify-send "Neovim theme" "No nvim colorscheme mapped for '$THEME_SLUG' yet — keeping the current one" 2>/dev/null || true
  exit 0
fi

NAME_FIELD=""
if [[ -n ${THEME_PLUGIN_NAME[$THEME_SLUG]:-} ]]; then
  NAME_FIELD="
  name = \"${THEME_PLUGIN_NAME[$THEME_SLUG]}\","
fi

cat >"$THEME_FILE" <<EOF
return {
  "$PLUGIN",$NAME_FIELD
  colorscheme = "$COLORSCHEME", -- used by omarchy-theme-hotreload
  lazy = false,
  priority = 1000,
  config = function()
    vim.cmd.colorscheme("$COLORSCHEME")
  end,
}
EOF
